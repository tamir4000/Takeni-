# =========================================
# TAKENI — Environment Variables
# =========================================

# PostgreSQL connection (from Neon dashboard → Connection string → Pooled)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection for migrations (from Neon dashboard → Connection string → Direct)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Strong random secret for JWT — change this!
JWT_SECRET="change-this-to-a-long-random-string-min-32-chars"

# Your production URL
NEXT_PUBLIC_APP_URL="https://takeni.org"
